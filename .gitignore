# Byte-compiled / cache
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Run artifacts — these are outputs, not sources. A released run belongs in a
# release or a data repository with its own DOI, not in the skill bundle.
# Note: eval/report.md, eval/results.csv, eval/sensitivity.md, eval/arms.md and
# eval/perception.md are deliberately NOT ignored. They are generated, but the
# deterministic ones carry the config_hash they were built from, so staleness is
# detectable, and a reviewer browsing the repository should be able to read the
# corpus results without installing Python first. Regenerate them whenever the
# config or the corpus changes; CI fails on a stale diff.
#
# eval/responses.md is generated too, but from collected replies rather than from
# the corpus, so it is regenerated by hand once replies exist.
logs/
tests/.scratch/
state/
*.state.json

# Editors and OS
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini
